{
  "name": "trucklink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --check src/index.mjs && node --check scripts/smoke.mjs",
    "test": "node --test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.132.0"
  }
}
