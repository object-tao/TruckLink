{
  "name": "trucklink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/integration.test.ts",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "vite build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply trucklink-db --local",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "hono": "4.13.8",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.0"
    }
  }
}
