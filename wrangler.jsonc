{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trucklink",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "dist/web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "trucklink-db", "database_id": "190bfc72-b6f9-406e-b1a9-8c5035df40b7", "migrations_dir": "migrations" }]
}
